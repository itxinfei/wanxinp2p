    <dependencies>
        <dependency>
            <groupId>com.xinfeip2p</groupId>
            <artifactId>xinfeip2p-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
